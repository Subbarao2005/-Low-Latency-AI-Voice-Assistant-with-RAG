# --- Voice processing ---
SARVAM_API_KEY=
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_STT_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_TTS_STREAM_URL=https://api.sarvam.ai/text-to-speech/stream

# --- LLM ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector DB ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb

# --- Cache ---
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=3600

# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/voice-assistant
ACTION_ROUTER_URL=http://localhost:8090/action

# --- Optional streaming relay (backend/orchestrator) ---
RELAY_PORT=8090
PORT=
RELAY_CALLBACK_BASE_URL=http://localhost:8090
FRONTEND_ORIGIN=http://localhost:8080

# --- Persistent lead database ---
DATABASE_URL=
DATABASE_SSL=true

# --- CRM / backend action hook (example) ---
CRM_WEBHOOK_URL=https://your-crm.example.com/api/leads
